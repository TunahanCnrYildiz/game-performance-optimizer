<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>optimizer</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Optimizer.Core\Optimizer.Core.csproj" />
    <ProjectReference Include="..\Optimizer.Platform.Windows\Optimizer.Platform.Windows.csproj" />
  </ItemGroup>
  <!-- Intel PresentMon (MIT), downloaded into tools\presentmon; not stored in git. -->
  <ItemGroup Condition="Exists('..\..\tools\presentmon\PresentMon.exe')">
    <None Include="..\..\tools\presentmon\PresentMon.exe" Link="tools\PresentMon.exe" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tools\presentmon\LICENSE.txt" Link="tools\PresentMon-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
