<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Optimizer.App.ViewModels"
        x:Class="Optimizer.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Performance Optimizer"
        Width="1180" Height="800" MinWidth="860" MinHeight="580"
        WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,10" />
    </Style>
    <Style Selector="Border.row">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
    </Style>
    <Style Selector="Border.badge">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="MinWidth" Value="64" />
    </Style>
    <Style Selector="Border.badge > TextBlock">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Opacity" Value="0.7" />
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.count">
      <Setter Property="FontSize" Value="26" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.fixable">
      <Setter Property="Foreground" Value="#2E9E5B" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto,*" Margin="20">

    <!-- Header -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
      <StackPanel Spacing="2">
        <TextBlock Text="Performance Optimizer" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Classes="muted"
                   Text="Hiçbir ayar siz onaylamadan değiştirilmez. Her değişiklik kaydedilir ve geri alınabilir." />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <TextBlock Classes="muted" Text="{Binding StatusText}" VerticalAlignment="Center" />
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Width="80" VerticalAlignment="Center" />
        <Button Content="Yeniden tara" Command="{Binding ScanCommand}" Classes="accent" />
      </StackPanel>
    </Grid>

    <!-- Message bar -->
    <Border Grid.Row="1" Classes="card" Margin="0,0,0,12" IsVisible="{Binding HasMessage}"
            BorderThickness="1" BorderBrush="#3B7DD8"
            Classes.error="{Binding MessageIsError}">
      <Border.Styles>
        <Style Selector="Border.error">
          <Setter Property="BorderBrush" Value="#D64545" />
        </Style>
      </Border.Styles>
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="Kapat" Command="{Binding DismissMessageCommand}" Margin="12,0,0,0" />
      </Grid>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="320,20,*">

      <!-- System summary -->
      <ScrollViewer Grid.Column="0">
        <StackPanel Spacing="8">
          <TextBlock Text="Sistem" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" />
          <ItemsControl ItemsSource="{Binding Summary}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SummaryRow">
                <Border Classes="card">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="muted" FontSize="12" Text="{Binding Label}" />
                    <TextBlock Text="{Binding Value}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Classes="card" IsVisible="{Binding HasErrors}">
            <StackPanel Spacing="4">
              <TextBlock Text="Okunamayan bölümler" FontWeight="SemiBold" />
              <ItemsControl ItemsSource="{Binding Errors}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Classes="muted" Text="{Binding}" TextWrapping="Wrap" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <TabControl Grid.Column="2" SelectedIndex="{Binding SelectedTab}" Padding="0,8,0,0">

        <!-- Findings -->
        <TabItem Header="Bulgular">
          <Grid RowDefinitions="Auto,Auto,*">
            <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,12">
              <Border Classes="card" Margin="0,0,8,0">
                <StackPanel>
                  <TextBlock Classes="count" Foreground="#D64545" Text="{Binding WarningCount}" />
                  <TextBlock Classes="muted" Text="Uyarı" />
                </StackPanel>
              </Border>
              <Border Classes="card" Margin="0,0,8,0">
                <StackPanel>
                  <TextBlock Classes="count" Foreground="#C98A00" Text="{Binding SuggestionCount}" />
                  <TextBlock Classes="muted" Text="Öneri" />
                </StackPanel>
              </Border>
              <Border Classes="card" Margin="0,0,8,0">
                <StackPanel>
                  <TextBlock Classes="count" Foreground="#3B7DD8" Text="{Binding InfoCount}" />
                  <TextBlock Classes="muted" Text="Bilgi" />
                </StackPanel>
              </Border>
              <Border Classes="card">
                <StackPanel>
                  <TextBlock Classes="count" Foreground="#2E9E5B" Text="{Binding OkCount}" />
                  <TextBlock Classes="muted" Text="Sorunsuz" />
                </StackPanel>
              </Border>
            </UniformGrid>

            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="Bulgular" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Classes="muted" VerticalAlignment="Bottom"
                           Text="{Binding FixableCount, StringFormat='{}{0} tanesi otomatik düzeltilebilir'}" />
              </StackPanel>
              <CheckBox Grid.Column="1" Content="Sorunsuz olanları göster" IsChecked="{Binding ShowPassed}" />
            </Grid>

            <ScrollViewer Grid.Row="2">
              <ItemsControl ItemsSource="{Binding Findings}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="6" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:FindingViewModel">
                    <Panel>
                      <!-- Findings without details: a flat row instead of a disabled (greyed-out) expander. -->
                      <Border Classes="row" IsVisible="{Binding !IsExpandable}" Padding="16,12,52,12">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                          <Border Classes="badge" Background="{Binding SeverityBrush}" Margin="0,0,12,0">
                            <TextBlock Text="{Binding SeverityText}" />
                          </Border>
                          <TextBlock Grid.Column="1" Text="{Binding Title}" TextWrapping="Wrap" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="2" Classes="muted" FontSize="12" Text="{Binding CategoryText}"
                                     Margin="12,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                      </Border>

                      <Expander HorizontalAlignment="Stretch" IsVisible="{Binding IsExpandable}">
                        <Expander.Header>
                          <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Classes="badge" Background="{Binding SeverityBrush}" Margin="0,0,12,0">
                              <TextBlock Text="{Binding SeverityText}" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding Title}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" Margin="12,0,0,0" VerticalAlignment="Center">
                              <TextBlock Classes="fixable" Text="Düzeltilebilir" IsVisible="{Binding CanFix}" />
                              <TextBlock Classes="muted" FontSize="12" Text="{Binding ImpactText}" IsVisible="{Binding HasImpact}" />
                              <TextBlock Classes="muted" FontSize="12" Text="{Binding CategoryText}" />
                            </StackPanel>
                          </Grid>
                        </Expander.Header>
                        <StackPanel Spacing="10" Margin="4,0">
                          <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" IsVisible="{Binding HasDetail}" />
                          <StackPanel Spacing="2" IsVisible="{Binding HasRecommendation}">
                            <TextBlock Text="Ne yapabilirsiniz" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Recommendation}" TextWrapping="Wrap" />
                          </StackPanel>
                          <StackPanel Spacing="2" IsVisible="{Binding HasCaveat}">
                            <TextBlock Text="Dikkat" FontWeight="SemiBold" Foreground="#C98A00" />
                            <TextBlock Text="{Binding Caveat}" TextWrapping="Wrap" />
                          </StackPanel>

                          <Border Classes="card" IsVisible="{Binding CanFix}">
                            <StackPanel Spacing="8">
                              <TextBlock Text="Otomatik düzeltme" FontWeight="SemiBold" />
                              <TextBlock Classes="muted" Text="Yapılacak değişiklikler:" FontSize="12" />
                              <ItemsControl ItemsSource="{Binding ChangeLines}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="x:String">
                                    <TextBlock Classes="mono" Text="{Binding}" />
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                              <TextBlock Classes="muted" FontSize="12" Text="{Binding FixNote}" TextWrapping="Wrap" />
                              <Button Classes="accent" Content="{Binding FixTitle}" Command="{Binding ApplyCommand}"
                                      IsEnabled="{Binding !$parent[Window].((vm:MainWindowViewModel)DataContext).IsBusy}" />
                            </StackPanel>
                          </Border>
                        </StackPanel>
                      </Expander>
                    </Panel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </TabItem>

        <!-- History -->
        <TabItem Header="Değişiklik geçmişi">
          <Grid RowDefinitions="Auto,*">
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
              <TextBlock Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center"
                         Text="Bu uygulamanın yaptığı her değişiklik, eski değerleriyle birlikte burada kayıtlı. Bir değer sonradan başka bir şey tarafından değiştirildiyse geri alırken ona dokunulmaz." />
              <Button Grid.Column="1" Content="Tümünü geri al" Margin="12,0,0,0"
                      Command="{Binding RevertAllCommand}" IsVisible="{Binding HasOpenChanges}" />
            </Grid>

            <TextBlock Grid.Row="1" Classes="muted" Text="Henüz hiçbir değişiklik yapılmadı."
                       IsVisible="{Binding !HasHistory}" />

            <ScrollViewer Grid.Row="1" IsVisible="{Binding HasHistory}">
              <ItemsControl ItemsSource="{Binding History}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="6" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:HistoryEntryViewModel">
                    <Border Classes="row" Padding="16,12">
                      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                          <Border Classes="badge" Background="{Binding StatusBrush}">
                            <TextBlock Text="{Binding StatusText}" />
                          </Border>
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                          <TextBlock Classes="muted" FontSize="12" Text="{Binding DateText}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1" Grid.RowSpan="3" VerticalAlignment="Top" Content="Geri al"
                                Command="{Binding RevertCommand}" IsVisible="{Binding CanRevert}"
                                IsEnabled="{Binding !$parent[Window].((vm:MainWindowViewModel)DataContext).IsBusy}" />
                        <ItemsControl Grid.Row="1" Margin="0,8,0,0" ItemsSource="{Binding ChangeLines}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                              <TextBlock Classes="mono" Text="{Binding}" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl Grid.Row="2" Margin="0,6,0,0" ItemsSource="{Binding Notes}" IsVisible="{Binding HasNotes}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                              <TextBlock Classes="muted" FontSize="12" Text="{Binding}" TextWrapping="Wrap" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </TabItem>

        <!-- Game sessions -->
        <TabItem Header="Oyun oturumları" DataContext="{Binding Sessions}" x:DataType="vm:SessionsViewModel">
          <ScrollViewer>
            <StackPanel Spacing="12">

              <Border Classes="card">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                               Text="Oyun sırasında hangi programların işlemci, ekran kartı ve disk kullandığı ölçülür; oyun bitince rapor burada görünür. Program açıkken çalışır; pencereyi kapatınca sistem tepsisinde çalışmaya devam eder." />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsMonitoring}" OnContent="İzleme açık" OffContent="İzleme kapalı"
                                VerticalAlignment="Center" Margin="12,0,0,0" />
                </Grid>
              </Border>

              <Border Classes="card" IsVisible="{Binding HasError}" BorderThickness="1" BorderBrush="#D64545">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding LastError}" TextWrapping="Wrap" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Content="Kapat" Command="{Binding DismissErrorCommand}" Margin="12,0,0,0" />
                </Grid>
              </Border>

              <Border Classes="card">
                <StackPanel Spacing="8">
                  <TextBlock Text="Oyun sırasında kısılan uygulamalar" FontWeight="SemiBold" />
                  <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                             Text="Bu listedeki uygulamalar oyun açıkken verimlilik moduna alınır (Görev Yöneticisi'ndeki 'Verimlilik modu' ile aynı: düşük öncelik + EcoQoS). Kapatılmazlar; oyun bitince eski hâline döner. Windows bileşenleri ve anti-cheat yazılımları eklenemez." />
                  <TextBlock Classes="muted" Text="Liste boş. Aşağıdaki raporlardan ya da elle ekleyebilirsiniz." IsVisible="{Binding !HasEfficiencyApps}" />
                  <ItemsControl ItemsSource="{Binding EfficiencyApps}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:EfficiencyAppViewModel">
                        <Border Classes="row" Padding="10,4" Margin="0,0,6,6">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                            <Button Content="✕" Padding="6,0" Command="{Binding RemoveCommand}" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox Width="240" PlaceholderText="Uygulama adı, ör. Discord" Text="{Binding NewAppName}" />
                    <Button Content="Ekle" Command="{Binding AddEfficiencyAppCommand}" />
                  </StackPanel>
                  <TextBlock Foreground="#D64545" Text="{Binding AddError}" IsVisible="{Binding AddError, Converter={x:Static ObjectConverters.IsNotNull}}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <TextBlock Text="Oturum raporları" FontSize="16" FontWeight="SemiBold" />
              <TextBlock Classes="muted" Text="Henüz kaydedilmiş oturum yok. İzleme açıkken bir oyun oynayın." IsVisible="{Binding !HasReports}" />

              <ItemsControl ItemsSource="{Binding Reports}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="6" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SessionReportViewModel">
                    <Expander HorizontalAlignment="Stretch">
                      <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                          <TextBlock Classes="muted" FontSize="12" Text="{Binding DateText}" VerticalAlignment="Center" />
                          <TextBlock Classes="muted" FontSize="12" Text="{Binding DurationText}" VerticalAlignment="Center" />
                          <TextBlock Classes="fixable" Foreground="#D64545" Text="İşlemci sınırlandı" IsVisible="{Binding IsCpuLimited}" VerticalAlignment="Center" />
                        </StackPanel>
                      </Expander.Header>
                      <StackPanel Spacing="10">
                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                        <TextBlock Classes="muted" Text="{Binding CpuText}" TextWrapping="Wrap" />
                        <TextBlock Foreground="#D64545" Text="{Binding LimitText}" TextWrapping="Wrap" IsVisible="{Binding IsCpuLimited}" />
                        <TextBlock Classes="muted" Text="{Binding EfficiencyText}" TextWrapping="Wrap" IsVisible="{Binding HasEfficiency}" />

                        <Grid ColumnDefinitions="*,70,70,90,90,150" Margin="0,6,0,0">
                          <TextBlock Classes="muted" FontSize="12" Text="Oyun dışındaki en büyük tüketiciler (ortalama)" />
                          <TextBlock Grid.Column="1" Classes="muted" FontSize="12" Text="CPU %" HorizontalAlignment="Right" />
                          <TextBlock Grid.Column="2" Classes="muted" FontSize="12" Text="GPU %" HorizontalAlignment="Right" />
                          <TextBlock Grid.Column="3" Classes="muted" FontSize="12" Text="G/Ç MB/s" HorizontalAlignment="Right" />
                          <TextBlock Grid.Column="4" Classes="muted" FontSize="12" Text="Bellek MB" HorizontalAlignment="Right" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Processes}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProcessUsageViewModel">
                              <Grid ColumnDefinitions="*,70,70,90,90,150" Margin="0,2">
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Classes="mono" Text="{Binding CpuText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Classes="mono" Text="{Binding GpuText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Classes="mono" Text="{Binding IoText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Classes="mono" Text="{Binding MemoryText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <Button Grid.Column="5" HorizontalAlignment="Right" FontSize="12" Padding="8,2"
                                        Content="{Binding ToggleText}" Command="{Binding ToggleCommand}" IsVisible="{Binding CanThrottle}" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Expander>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- FPS measurement -->
        <TabItem Header="FPS ölçümü" DataContext="{Binding Benchmarks}" x:DataType="vm:BenchmarksViewModel">
          <ScrollViewer>
            <StackPanel Spacing="12">

              <Border Classes="card" IsVisible="{Binding IsUnavailable}" BorderThickness="1" BorderBrush="#D64545">
                <TextBlock TextWrapping="Wrap"
                           Text="Ölçüm aracı (Intel PresentMon) bulunamadı. Uygulamanın yanındaki tools klasöründe PresentMon.exe olmalı." />
              </Border>

              <Border Classes="card" IsVisible="{Binding IsAvailable}">
                <StackPanel Spacing="10">
                  <TextBlock Text="Yeni ölçüm" FontWeight="SemiBold" />
                  <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                             Text="Bir ayarın gerçekten işe yarayıp yaramadığını kendi bilgisayarınızda görmek için: ayarı değiştirmeden önce ve sonra, oyunda aynı sahnede ölçün ve her ölçüme o durumu anlatan bir etiket verin. Her durumu en az 2 kez ölçün (A, B, A, B); tek ölçümlük farklar çoğu zaman rastlantıdır." />
                  <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                    <TextBlock Text="Oyun" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:TargetProcess">
                          <TextBlock Text="{Binding Display}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Column="2" Content="Yenile" Command="{Binding RefreshTargetsCommand}" />

                    <TextBlock Grid.Row="1" Text="Etiket" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Label}" PlaceholderText="ör. Discord kapalı" />

                    <TextBlock Grid.Row="2" Text="Süre (sn)" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding DurationOptions}" SelectedItem="{Binding Seconds}" />
                  </Grid>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="accent" Content="Ölçümü başlat" Command="{Binding MeasureCommand}" />
                    <Button Content="İptal" Command="{Binding CancelCommand}" IsVisible="{Binding IsMeasuring}" />
                    <ProgressBar IsIndeterminate="True" Width="80" IsVisible="{Binding IsMeasuring}" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock Text="{Binding Status}" TextWrapping="Wrap"
                             IsVisible="{Binding Status, Converter={x:Static ObjectConverters.IsNotNull}}"
                             Classes.error="{Binding StatusIsError}">
                    <TextBlock.Styles>
                      <Style Selector="TextBlock.error">
                        <Setter Property="Foreground" Value="#D64545" />
                      </Style>
                    </TextBlock.Styles>
                  </TextBlock>
                </StackPanel>
              </Border>

              <Border Classes="card" IsVisible="{Binding HasRuns}">
                <StackPanel Spacing="8">
                  <TextBlock Text="Karşılaştır" FontWeight="SemiBold" />
                  <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" ColumnSpacing="8">
                    <TextBlock Text="Oyun" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Games}" SelectedItem="{Binding CompareGame}" />
                    <TextBlock Grid.Column="2" Text="A" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="3" HorizontalAlignment="Stretch" ItemsSource="{Binding Labels}" SelectedItem="{Binding LabelA}" />
                    <TextBlock Grid.Column="4" Text="B" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="5" HorizontalAlignment="Stretch" ItemsSource="{Binding Labels}" SelectedItem="{Binding LabelB}" />
                  </Grid>
                  <TextBlock Text="{Binding ComparisonText}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <TextBlock Text="Ölçümler" FontSize="16" FontWeight="SemiBold" IsVisible="{Binding HasRuns}" />
              <Grid ColumnDefinitions="*,80,80,80,80,70" IsVisible="{Binding HasRuns}">
                <TextBlock Classes="muted" FontSize="12" Text="Oyun — etiket" />
                <TextBlock Grid.Column="1" Classes="muted" FontSize="12" Text="Ort. FPS" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="2" Classes="muted" FontSize="12" Text="1% low" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="3" Classes="muted" FontSize="12" Text="0.1% low" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="4" Classes="muted" FontSize="12" Text="Takılma" HorizontalAlignment="Right" />
              </Grid>
              <ItemsControl ItemsSource="{Binding Runs}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="6" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:BenchmarkRunViewModel">
                    <Border Classes="row" Padding="12,8">
                      <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*,80,80,80,80,70">
                          <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Classes="muted" FontSize="12" Text="{Binding DateText}" VerticalAlignment="Center" />
                          </StackPanel>
                          <TextBlock Grid.Column="1" Classes="mono" Text="{Binding AvgText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="2" Classes="mono" Text="{Binding Low1Text}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="3" Classes="mono" Text="{Binding Low01Text}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="4" Classes="mono" Text="{Binding StutterText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                          <Button Grid.Column="5" Content="Sil" FontSize="12" Padding="8,2" HorizontalAlignment="Right" Command="{Binding DeleteCommand}" />
                        </Grid>
                        <TextBlock Classes="muted" FontSize="12" Text="{Binding Details}" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </Grid>
  </Grid>
</Window>
