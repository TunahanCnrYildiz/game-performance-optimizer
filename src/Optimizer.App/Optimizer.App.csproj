<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net10.0-windows;net10.0</TargetFrameworks>
    <AssemblyName>PerformanceOptimizer</AssemblyName>
    <ApplicationManifest Condition="'$(TargetFramework)' == 'net10.0-windows'">app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Optimizer.Core\Optimizer.Core.csproj" />
    <ProjectReference Include="..\Optimizer.Platform.Windows\Optimizer.Platform.Windows.csproj" Condition="'$(TargetFramework)' == 'net10.0-windows'" />
    <ProjectReference Include="..\Optimizer.Platform.Linux\Optimizer.Platform.Linux.csproj" Condition="'$(TargetFramework)' == 'net10.0'" />
  </ItemGroup>
  <!-- Intel PresentMon (MIT), downloaded into tools\presentmon; not stored in git. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows' And Exists('..\..\tools\presentmon\PresentMon.exe')">
    <None Include="..\..\tools\presentmon\PresentMon.exe" Link="tools\PresentMon.exe" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tools\presentmon\LICENSE.txt" Link="tools\PresentMon-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
